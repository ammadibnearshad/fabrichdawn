{% comment %}
  Renders the Cambridge-style share row: a label followed by real share URLs for
  Facebook, X, Pinterest and WhatsApp. These are plain links, not Dawn's
  copy-link `share-button`, so they work without JavaScript.

  Accepts:
  - product: {Object} Product Liquid object. Required.
  - block: {Object} The `cm_share` block. Required.

  Usage:
  {% render 'cm-share-links', product: product, block: block %}
{% endcomment %}

{%- liquid
  # Always share the canonical /products/<handle> URL, never the collection path.
  assign cm_sh_url = request.origin | append: product.url
  assign cm_sh_url_encoded = cm_sh_url | url_encode
  assign cm_sh_title = product.title | escape
  assign cm_sh_title_encoded = product.title | url_encode

  assign cm_sh_image = ''
  if product.featured_image != blank
    assign cm_sh_image = product.featured_image | image_url: width: 1024 | prepend: 'https:' | url_encode
  endif

  assign cm_sh_whatsapp_text = product.title | append: ' ' | append: cm_sh_url | url_encode
  assign cm_sh_email_body = product.title | append: ' ' | append: cm_sh_url | url_encode
-%}

<div
  class="cm-share cm-share--{{ block.settings.style | default: 'icon' }}"
  style="--cm-share-icon-size: {{ block.settings.icon_size | default: 20 }}px;"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.label != blank -%}
    <span class="cm-share__label">{{ block.settings.label | escape }}</span>
  {%- endif -%}

  <ul class="cm-share__list list-unstyled" role="list">
    {%- if block.settings.facebook -%}
      <li class="cm-share__item">
        <a
          class="cm-share__link"
          href="https://www.facebook.com/sharer/sharer.php?u={{ cm_sh_url_encoded }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="{{ 'products.product.cm.share_on' | t: network: 'Facebook' }}"
        >
          <svg class="cm-share__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.twitter -%}
      <li class="cm-share__item">
        <a
          class="cm-share__link"
          href="https://twitter.com/intent/tweet?text={{ cm_sh_title_encoded }}&url={{ cm_sh_url_encoded }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="{{ 'products.product.cm.share_on' | t: network: 'X' }}"
        >
          <svg class="cm-share__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M17.53 3h3.06l-6.69 7.64L21.75 21h-5.98l-4.69-6.13L5.72 21H2.66l7.15-8.17L2.25 3h6.13l4.24 5.6L17.53 3Zm-1.07 16.17h1.7L7.62 4.73H5.8l10.66 14.44Z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.pinterest -%}
      <li class="cm-share__item">
        <a
          class="cm-share__link"
          href="https://pinterest.com/pin/create/button/?url={{ cm_sh_url_encoded }}{% if cm_sh_image != blank %}&media={{ cm_sh_image }}{% endif %}&description={{ cm_sh_title_encoded }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="{{ 'products.product.cm.share_on' | t: network: 'Pinterest' }}"
        >
          <svg class="cm-share__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 2a10 10 0 0 0-3.65 19.31c-.09-.79-.17-2 .03-2.86.19-.79 1.2-5.04 1.2-5.04s-.3-.61-.3-1.52c0-1.42.82-2.48 1.85-2.48.87 0 1.29.65 1.29 1.44 0 .88-.56 2.19-.85 3.41-.24 1.02.51 1.85 1.52 1.85 1.83 0 3.23-1.93 3.23-4.71 0-2.46-1.77-4.18-4.29-4.18-2.92 0-4.64 2.19-4.64 4.46 0 .88.34 1.83.76 2.35a.3.3 0 0 1 .07.29c-.08.32-.25.98-.28 1.12-.05.19-.15.23-.35.14-1.3-.61-2.11-2.5-2.11-4.03 0-3.28 2.38-6.29 6.87-6.29 3.6 0 6.41 2.57 6.41 6 0 3.58-2.26 6.47-5.39 6.47-1.05 0-2.04-.55-2.38-1.2l-.65 2.47c-.23.9-.86 2.03-1.28 2.72A10 10 0 1 0 12 2Z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.whatsapp -%}
      <li class="cm-share__item">
        <a
          class="cm-share__link"
          href="https://wa.me/?text={{ cm_sh_whatsapp_text }}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          aria-label="{{ 'products.product.cm.share_on' | t: network: 'WhatsApp' }}"
        >
          <svg class="cm-share__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.17-1.35a9.93 9.93 0 0 0 4.87 1.24h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.9 9.9 0 0 0 12.04 2Zm0 18.18h-.01a8.27 8.27 0 0 1-4.21-1.15l-.3-.18-3.07.8.82-2.99-.2-.31a8.25 8.25 0 0 1-1.27-4.39c0-4.57 3.72-8.28 8.29-8.28 2.21 0 4.29.86 5.86 2.43a8.23 8.23 0 0 1 2.42 5.86c0 4.57-3.72 8.21-8.33 8.21Zm4.55-6.16c-.25-.12-1.47-.73-1.7-.81-.23-.08-.4-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29Z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.email -%}
      <li class="cm-share__item">
        <a
          class="cm-share__link"
          href="mailto:?subject={{ cm_sh_title_encoded }}&body={{ cm_sh_email_body }}"
          aria-label="{{ 'products.product.cm.share_by_email' | t }}"
        >
          <svg class="cm-share__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
            <rect x="2.75" y="4.75" width="18.5" height="14.5" rx="1.5"/>
            <path d="m3 6 9 6.5L21 6"/>
          </svg>
        </a>
      </li>
    {%- endif -%}

    {%- if block.settings.copy_link -%}
      <li class="cm-share__item">
        <a
          class="cm-share__link"
          href="{{ cm_sh_url }}"
          data-cm-copy-link
          aria-label="{{ 'products.product.cm.copy_link' | t }}"
        >
          <svg class="cm-share__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
            <path d="M10 13a4 4 0 0 0 5.66 0l3-3A4 4 0 0 0 13 4.34l-1.4 1.4"/>
            <path d="M14 11a4 4 0 0 0-5.66 0l-3 3A4 4 0 0 0 11 19.66l1.4-1.4"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
  </ul>

  {%- if block.settings.native_share_mobile -%}
    <cm-native-share
      class="cm-share__native"
      data-title="{{ cm_sh_title }}"
      data-url="{{ cm_sh_url }}"
      hidden
    >
      <button type="button" class="cm-share__native-button link">
        {{ 'products.product.cm.share_native' | t }}
      </button>
    </cm-native-share>
  {%- endif -%}
</div>
