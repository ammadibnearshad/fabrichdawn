{% comment %}
  Renders the desktop header navigation with a fully customizable mega menu.

  Each top-level item of the header menu renders as one of three things:
    1. Mega menu   - a "Mega menu" block is assigned to it and it has at least one
                     image. Two-level menus list their links in a single column;
                     three-level menus use headed columns.
    2. Dropdown    - it has sub-links but no images (child + grandchild)
    3. Plain link  - it has no sub-links

  Panels are built from header section blocks, matched to a top-level link on
  the handleized title, so "Bottoms", "bottoms" and "BOTTOMS" all match:
    - "Mega menu"       -> layout, column source, badge and colour for one item
    - "Mega menu image" -> up to two linkable image cards, shown by default for the
                           top-level item or only while a 2nd / 3rd-level link is
                           hovered or focused (swapped by <mega-menu-panel>)

  Open trigger:
    - hover_mode true  -> <mega-menu-item>: an anchor plus a panel, opened on
      hover and on keyboard focus. The top-level label stays a real link, so it
      still navigates and is still crawlable. On touch the first tap opens the
      panel and the second follows the link.
    - hover_mode false -> Dawn's native <details>/<summary>, driven by global.js.

  Accepts:
  - hover_mode: {Boolean} open on hover instead of click
  - show_caret: {Boolean} show the dropdown arrow next to a parent item
  - open_delay: {Number} hover intent delay in ms

  Usage:
  {% render 'header-mega-menu-custom', hover_mode: true, show_caret: false, open_delay: 80 %}
{% endcomment %}

{%- liquid
  assign panel_blocks = section.blocks | where: 'type', 'mega_menu'
  assign image_blocks = section.blocks | where: 'type', 'mega_image'
-%}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign link_key = link.title | handleize

        assign config = false
        for panel_block in panel_blocks
          assign panel_key = panel_block.settings.menu_item | handleize
          if panel_key == link_key
            assign config = panel_block
            break
          endif
        endfor

        # One media key per image block, index-aligned with image_blocks:
        #   'main'           -> default images for the top-level item
        #   'c-<child>'      -> shown while a 2nd-level link is hovered
        #   'g-<grandchild>' -> shown while a 3rd-level link is hovered
        #                       (sub item may be "Parent / Child" to disambiguate)
        #   'none'           -> block belongs to another item or has no image
        assign media_keys = ''
        for image_block in image_blocks
          assign media_key = 'none'
          assign image_key = image_block.settings.menu_item | handleize
          if image_key == link_key
            if image_block.settings.image != blank or image_block.settings.image_2 != blank
              assign sub_key = image_block.settings.sub_item | handleize
              case image_block.settings.menu_level
                when 'child'
                  if sub_key != blank
                    assign media_key = 'c-' | append: sub_key
                  endif
                when 'grandchild'
                  if sub_key != blank
                    assign media_key = 'g-' | append: sub_key
                  endif
                else
                  assign media_key = 'main'
              endcase
            endif
          endif
          assign media_keys = media_keys | append: media_key | append: ','
        endfor
        assign media_keys = media_keys | split: ','
        assign group_keys = media_keys | uniq

        # Default group: top-level images, else the first sub-item group.
        assign default_media = ''
        assign group_count = 0
        for group_key in group_keys
          if group_key != 'none'
            assign group_count = group_count | plus: 1
            if default_media == blank
              assign default_media = group_key
            endif
          endif
        endfor
        if group_keys contains 'main'
          assign default_media = 'main'
        endif

        assign media_switch = false
        if group_count > 1
          assign media_switch = true
        endif

        assign child_links = link.links
        if config and config.settings.menu != blank
          assign child_links = config.settings.menu.links
        endif

        assign has_grandchildren = false
        for childlink in child_links
          if childlink.links != blank
            assign has_grandchildren = true
            break
          endif
        endfor

        # A mega panel needs at least one image; without one the item falls back to a dropdown.
        assign is_mega = false
        if config and config.settings.enable_mega and group_count > 0
          assign is_mega = true
        endif

        assign has_panel = false
        if is_mega or child_links != blank
          assign has_panel = true
        endif

        assign item_style = ''
        if config and config.settings.item_color != blank
          capture item_style
            echo 'style="--mega-item-color: '
            echo config.settings.item_color
            echo ';"'
          endcapture
        endif
      -%}

      {%- capture trigger_label -%}
        <span class="mega-custom__item-label{% if link.current or link.child_active %} header__active-menu-item{% endif %}">
          {{- link.title | escape -}}
        </span>
        {%- if config and config.settings.badge_text != blank -%}
          <span
            class="mega-custom__badge"
            style="--mega-badge-bg: {{ config.settings.badge_background }}; --mega-badge-fg: {{ config.settings.badge_text_color }};"
          >
            {{- config.settings.badge_text | escape -}}
          </span>
        {%- endif -%}
        {%- if show_caret and has_panel -%}
          <span class="mega-custom__caret" aria-hidden="true">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
      {%- endcapture -%}

      {%- capture panel_content -%}
        {%- if is_mega -%}
          {%- liquid
            assign columns = config.settings.columns
            assign column_count = child_links.size
            if column_count > 0 and column_count < columns
              assign columns = column_count
            endif

            assign media_position = config.settings.image_position
          -%}
          <div
            id="MegaMenu-Content-{{ forloop.index }}"
            class="mega-custom__panel mega-custom__panel--{{ config.settings.panel_width }} color-{{ config.settings.color_scheme }} gradient motion-reduce"
            tabindex="-1"
            {{ config.shopify_attributes }}
          >
            <mega-menu-panel
              class="mega-custom__inner mega-custom__inner--{{ media_position }}{% if config.settings.panel_width == 'page' %} page-width{% endif %}"
              data-default-media="{{ default_media }}"
            >
              {%- assign card_sizes = config.settings.image_width | append: 'px' -%}
              <div class="mega-custom__media" style="--mega-media-width: {{ config.settings.image_width }}px;">
                {%- for group_key in group_keys -%}
                  {%- if group_key == 'none' -%}
                    {%- continue -%}
                  {%- endif -%}
                  <div
                    class="mega-custom__media-group"
                    data-mega-media-group="{{ group_key }}"
                    {% unless group_key == default_media %}
                      inert
                    {% endunless %}
                  >
                    {%- for image_block in image_blocks -%}
                      {%- if media_keys[forloop.index0] != group_key -%}
                        {%- continue -%}
                      {%- endif -%}
                      {%- liquid
                        # Editor attributes go on the block's first rendered card only.
                        assign second_attributes = ''
                        if image_block.settings.image == blank
                          assign second_attributes = image_block.shopify_attributes
                        endif

                        render 'card-mega-menu-image', image: image_block.settings.image, link: image_block.settings.link, heading: image_block.settings.heading, caption: image_block.settings.caption, ratio: config.settings.image_ratio, sizes: card_sizes, fallback_alt: link.title, attributes: image_block.shopify_attributes
                        render 'card-mega-menu-image', image: image_block.settings.image_2, link: image_block.settings.link_2, heading: image_block.settings.heading_2, caption: image_block.settings.caption_2, ratio: config.settings.image_ratio, sizes: card_sizes, fallback_alt: link.title, attributes: second_attributes
                      -%}
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>

              {%- if child_links != blank and has_grandchildren == false -%}
                <ul class="mega-custom__list list-unstyled" role="list">
                  {%- for childlink in child_links -%}
                    {%- liquid
                      assign child_target = childlink.title | handleize | prepend: 'c-'
                      unless group_keys contains child_target
                        assign child_target = default_media
                      endunless
                    -%}
                    <li>
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="mega-custom__link{% if childlink.current %} mega-custom__link--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                        {% if media_switch %}
                          data-mega-media="{{ child_target }}"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif child_links != blank -%}
                <ul class="mega-custom__columns list-unstyled" role="list" style="--mega-columns: {{ columns }};">
                  {%- for childlink in child_links -%}
                    {%- liquid
                      assign child_key = childlink.title | handleize
                      assign child_target = child_key | prepend: 'c-'
                      unless group_keys contains child_target
                        assign child_target = default_media
                      endunless
                    -%}
                    <li class="mega-custom__col">
                      {%- if childlink.url == blank or childlink.url == '#' -%}
                        <span
                          class="mega-custom__col-title"
                          {% if media_switch %}
                            data-mega-media="{{ child_target }}"
                          {% endif %}
                        >
                          {{- childlink.title | escape -}}
                        </span>
                      {%- else -%}
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="mega-custom__col-title mega-custom__col-title--link{% if childlink.current %} mega-custom__link--active{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                          {% if media_switch %}
                            data-mega-media="{{ child_target }}"
                          {% endif %}
                        >
                          {{ childlink.title | escape }}
                        </a>
                      {%- endif -%}

                      {%- if childlink.links != blank -%}
                        <ul class="list-unstyled" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            {%- liquid
                              # Most specific first: "Parent / Child", then "Child", then the parent's images.
                              assign grand_key = grandchildlink.title | handleize
                              assign grand_target = 'g-' | append: child_key | append: '-' | append: grand_key
                              unless group_keys contains grand_target
                                assign grand_target = grand_key | prepend: 'g-'
                                unless group_keys contains grand_target
                                  assign grand_target = child_target
                                endunless
                              endunless
                            -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="mega-custom__link{% if grandchildlink.current %} mega-custom__link--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                                {% if media_switch %}
                                  data-mega-media="{{ grand_target }}"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </mega-menu-panel>
          </div>
        {%- else -%}
          <ul
            id="MegaMenu-Content-{{ forloop.index }}"
            class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
            role="list"
            tabindex="-1"
          >
            {%- for childlink in child_links -%}
              <li>
                {%- if childlink.links == blank -%}
                  <a
                    id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                    href="{{ childlink.url }}"
                    class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                    {% if childlink.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{ childlink.title | escape }}
                  </a>
                {%- else -%}
                  <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                    <summary
                      id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                      class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                    >
                      <span>{{ childlink.title | escape }}</span>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <ul
                      id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}"
                      class="header__submenu list-menu motion-reduce"
                      role="list"
                    >
                      {%- for grandchildlink in childlink.links -%}
                        <li>
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                            href="{{ grandchildlink.url }}"
                            class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                            {% if grandchildlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ grandchildlink.title | escape }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endcapture -%}

      <li>
        {%- if has_panel == false -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset mega-custom__item"
            {% if link.current %}
              aria-current="page"
            {% endif %}
            {{ item_style }}
          >
            {{ trigger_label }}
          </a>

        {%- elsif hover_mode -%}
          <mega-menu-item class="mega-custom{% unless is_mega %} mega-custom--dropdown{% endunless %}" data-open-delay="{{ open_delay | default: 80 }}" data-close-delay="240">
            <a
              id="HeaderMenu-{{ link.handle }}"
              href="{{ link.url }}"
              class="header__menu-item list-menu__item link focus-inset mega-custom__item"
              data-mega-trigger
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="MegaMenu-Content-{{ forloop.index }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
              {{ item_style }}
            >
              {{ trigger_label }}
            </a>
            {{ panel_content }}
          </mega-menu-item>

        {%- else -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-custom{% unless is_mega %} mega-custom--dropdown{% endunless %}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset mega-custom__item"
                {{ item_style }}
              >
                {{ trigger_label }}
              </summary>
              {{ panel_content }}
            </details>
          </header-menu>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
