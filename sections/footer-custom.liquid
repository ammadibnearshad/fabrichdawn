{{ 'section-footer-custom.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-footer-custom.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign utility_blocks = section.blocks | where: 'type', 'utility'

  assign column_count = 0
  for block in section.blocks
    case block.type
      when 'menu', 'text', 'newsletter'
        assign column_count = column_count | plus: 1
    endcase
  endfor
-%}

<footer class="footer-custom color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}{% if section.settings.show_top_border %} footer-custom--top-border{% endif %}">
  {%- if utility_blocks.size > 0 -%}
    <div class="footer-custom__utility page-width" style="--utility-icon-size: {{ section.settings.utility_icon_size }}px;">
      {%- assign positions = 'start,end' | split: ',' -%}
      {%- for position in positions -%}
        {%- liquid
          assign group_count = 0
          for block in utility_blocks
            if block.settings.position == position
              assign group_count = group_count | plus: 1
            endif
          endfor
        -%}
        {%- if group_count > 0 -%}
          <div class="footer-custom__utility-group footer-custom__utility-group--{{ position }}">
            {%- for block in utility_blocks -%}
              {%- if block.settings.position != position -%}
                {%- continue -%}
              {%- endif -%}
              {%- liquid
                assign item_tag = 'div'
                if block.settings.link != blank
                  assign item_tag = 'a'
                endif

                assign has_icon = false
                if block.settings.image != blank or block.settings.icon != 'none'
                  assign has_icon = true
                endif
              -%}
              <{{ item_tag }}
                class="footer-custom__utility-item"
                {% if item_tag == 'a' %}
                  href="{{ block.settings.link }}"
                {% endif %}
                {% if item_tag == 'a' and block.settings.label == blank and block.settings.icon != 'none' %}
                  aria-label="{{ block.settings.icon | replace: '_', ' ' | capitalize }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {%- if has_icon -%}
                  <span class="footer-custom__utility-icon" aria-hidden="true">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 120
                        | image_tag: loading: 'lazy', widths: '30, 60, 90, 120', sizes: '30px', alt: ''
                      }}
                    {%- else -%}
                      {%- render 'icon-utility', name: block.settings.icon -%}
                    {%- endif -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="footer-custom__utility-label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </{{ item_tag }}>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if column_count > 0 -%}
    <footer-accordions class="footer-custom__main page-width" style="--footer-columns: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- capture menu_links -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer-custom__list list-unstyled" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="footer-custom__link{% if link.active %} footer-custom__link--active{% endif %}"
                        {% if link.active %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endcapture -%}
            <div class="footer-custom__block footer-custom__block--menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                {%- comment -%}
                  Open by default so the menu is readable without JS; footer-accordions
                  collapses it below 750px and re-opens it above.
                {%- endcomment -%}
                <details class="footer-custom__details" open>
                  <summary class="footer-custom__summary">
                    <h2 class="footer-custom__heading inline-richtext">{{ block.settings.heading }}</h2>
                    <span class="footer-custom__summary-icon" aria-hidden="true">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </summary>
                  <div class="footer-custom__details-content">
                    {{ menu_links }}
                  </div>
                </details>
              {%- else -%}
                {{ menu_links }}
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="footer-custom__block footer-custom__block--text" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-custom__heading inline-richtext">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="footer-custom__text rte">{{ block.settings.content }}</div>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            {%- capture form_id -%}FooterNewsletter-{{ block.id }}{%- endcapture -%}
            <div class="footer-custom__block footer-custom__block--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-custom__heading inline-richtext">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <div class="footer-custom__text rte">{{ block.settings.subtext }}</div>
              {%- endif -%}

              {%- form 'customer', id: form_id, class: 'footer-custom__newsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">
                  {{- 'newsletter.label' | t -}}
                </label>
                <div class="footer-custom__newsletter-field">
                  <input
                    id="NewsletterEmail-{{ block.id }}"
                    type="email"
                    name="contact[email]"
                    class="footer-custom__newsletter-input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    required
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="NewsletterError-{{ block.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="NewsletterSuccess-{{ block.id }}"
                    {% endif %}
                  >
                  <button type="submit" class="footer-custom__newsletter-button" name="commit">
                    {{- block.settings.button_label | escape -}}
                  </button>
                </div>

                {%- if form.errors -%}
                  <small class="footer-custom__newsletter-message" id="NewsletterError-{{ block.id }}">
                    <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                  <small
                    class="footer-custom__newsletter-message footer-custom__newsletter-message--success"
                    id="NewsletterSuccess-{{ block.id }}"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                    {{- 'newsletter.success' | t -}}
                  </small>
                {%- endif -%}
              {%- endform -%}

              {%- if block.settings.show_social -%}
                <div class="footer-custom__social-row">
                  {%- render 'footer-custom-social',
                    class: 'footer-custom__social',
                    whatsapp: section.settings.whatsapp_link
                  -%}
                </div>
              {%- endif -%}
            </div>

          {%- when '@app' -%}
            <div class="footer-custom__block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </footer-accordions>
  {%- endif -%}

  {%- liquid
    assign show_country = false
    if section.settings.enable_country_selector and localization.available_countries.size > 1
      assign show_country = true
    endif

    assign show_language = false
    if section.settings.enable_language_selector and localization.available_languages.size > 1
      assign show_language = true
    endif
  -%}

  {%- if section.settings.show_bottom_bar -%}
    <div class="footer-custom__bottom page-width">
      <div class="footer-custom__bottom-start">
        <small class="footer-custom__copyright">
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
          {{ powered_by_link }}
        </small>

        {%- if section.settings.show_policy -%}
          <ul class="footer-custom__policies list-unstyled" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a href="{{ policy.url }}" class="footer-custom__policy-link">{{ policy.title | escape }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer-custom__bottom-end">
        {%- if show_country or show_language -%}
          <div class="footer-custom__localization isolate">
            {%- if show_country -%}
              <localization-form>
                {%- form 'localization', id: 'FooterCustomCountryForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="FooterCustomCountryLabel">
                      {{- 'localization.country_label' | t -}}
                    </h2>
                    {%- render 'country-localization', localPosition: 'FooterCustomCountry' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            {%- endif -%}

            {%- if show_language -%}
              <localization-form>
                {%- form 'localization', id: 'FooterCustomLanguageForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="FooterCustomLanguageLabel">
                      {{- 'localization.language_label' | t -}}
                    </h2>
                    {%- render 'language-localization', localPosition: 'FooterCustomLanguage' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.payment_enable -%}
          <div class="footer-custom__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer (custom)",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "default": true,
      "label": "Show top border"
    },
    {
      "type": "header",
      "content": "Utility bar",
      "info": "Add \"Utility item\" blocks for the row above the footer columns, e.g. Find a store and Get in touch."
    },
    {
      "type": "range",
      "id": "utility_icon_size",
      "min": 32,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 56,
      "label": "Icon circle size"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop",
      "info": "Stacks to 1 column on mobile and 2 on tablet."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp link",
      "info": "Optional. Shown with the other social icons. Other networks come from Theme settings > Social media."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bar",
      "default": true,
      "label": "Show bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.footer.settings.enable_country_selector.label"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.footer.settings.enable_language_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "utility",
      "name": "Utility item",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "options": [
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "start",
          "label": "Position"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "map_pin",
              "label": "Map pin"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "envelope",
              "label": "Envelope"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "question",
              "label": "Question mark"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "price_tag",
              "label": "Price tag"
            },
            {
              "value": "stopwatch",
              "label": "Stopwatch"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "plane",
              "label": "Plane"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "shirt",
              "label": "Shirt"
            },
            {
              "value": "ruler",
              "label": "Ruler"
            },
            {
              "value": "account",
              "label": "Account"
            }
          ],
          "default": "map_pin",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "label",
          "default": "Find a store",
          "label": "Label",
          "info": "Leave empty for an icon-only item."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Accepts tel: and mailto: links."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
