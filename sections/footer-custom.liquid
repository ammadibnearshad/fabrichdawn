        {
          "type": "text",
          "id": "button_label",
          "default": "Subscribe",
          "label": "Button label"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "Show social icons"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Footer (custom)",
      "blocks": [
        {
          "type": "utility",
          "settings": {
            "position": "start",
            "icon": "map_pin",
            "label": "Find a store"
          }
        },
        {
          "type": "utility",
          "settings": {
            "position": "end",
            "icon": "phone",
            "label": ""
          }
        },
        {
          "type": "utility",
          "settings": {
            "position": "end",
            "icon": "envelope",
            "label": ""
          }
        },
        {
          "type": "utility",
          "settings": {
            "position": "end",
            "icon": "none",
            "label": "Get in touch"
          }
        },
        {
          "type": "text"
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Order information"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help"
          }
        },
        {
