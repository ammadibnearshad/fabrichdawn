        "show_product_count": true,
        "product_count_label": "Products :",
        "full_width_grid": false,
        "enable_column_switcher": false,
        "grid_gap_desktop": 20,
        "grid_gap_mobile": 12,
        "row_gap_desktop": 40,
        "row_gap_mobile": 28,
        "pagination_type": "load_more",
        "padding_top": 0,
        "padding_bottom": 36
      }
    }
