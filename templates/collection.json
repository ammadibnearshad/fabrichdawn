{
  "sections": {
    "banner": {
      "type": "cm-collection-banner",
      "settings": {
        "show_image": true,
        "image_height_desktop": "adapt",
        "image_height_mobile": "adapt",
        "mobile_image_source": "same",
        "full_width": true,
        "show_breadcrumb": true,
        "breadcrumb_separator": "/",
        "show_title": true,
        "title_uppercase": true,
        "title_size": "h1",
        "show_description": false,
        "content_alignment": "left",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 24
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
